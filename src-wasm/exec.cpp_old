static void throwNonObjectError(JS::HandleValue errorValue)
{
    clearData();
    data.dataBuffer = data.auxBuffer;
    data.dataType = DataType::GuestError;
    data.dataOwned = 0;

    // Append error name
    strcpy(data.dataBuffer, "GuestError");
    data.dataSize = 10;

    // Append null separator and error message
    auto written = stringToFixedBuffer(errorValue, data.dataBuffer + data.dataSize + 1, AUX_BUFFER_SIZE - data.dataSize - 1);
    if (written < 0) {
        logWarning("Cannot stringify error value.");
        throwEngineError("Cannot stringify error value.");
        return;
    }
    data.dataBuffer[data.dataSize] = 0;
    data.dataSize += 1 + written;

    // Append null separator and current stack if available
    appendCurrentStackTrace();
    JS_ClearPendingException(cx);
}

static void throwPendingErrorImpl()
{
    JS::RootedValue errorValue(cx);

    if (!JS_GetPendingException(cx, &errorValue)) {
        throwEngineError("Cannot get pending exception.");
        return;
    }

    if (errorValue.isObject()) {
        JS::RootedObject errorObj(cx, &errorValue.toObject());
        throwObjectError(errorObj);
    } else {
        throwNonObjectError(errorValue);
    }
}


void throwPendingError() {
    throwPendingErrorImpl();
    JS_ClearPendingException(cx);
}

#pragma endregion


