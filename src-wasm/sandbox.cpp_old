#pragma region ------------------ CODE EXECUTION ------------------


static bool stringToFixedBuffer(JS::HandleValue strValue, char* buffer, uint32_t &size)
{
    JS::RootedString str(cx, strValue.toString());
    uint32_t length = JS_GetStringLength(str);
    auto stat = JS_EncodeStringToUTF8BufferPartial(cx, str, mozilla::Span(buffer, size));
    if (stat.isNothing()) {
        return false;
    }
    auto read = std::get<0>(*stat);
    if (read == length) {
        size = std::get<1>(*stat);
        return true;
    } else {
        return false;
    }
}


static void throwEngineErrorInner(const char* message)
{
    data.clear();
    data.dataBuffer = data.auxBuffer;
    data.dataType = ResultType::EngineError;
    data.dataOwned = 0;

    if (!message || 11 + 1 + strlen(message) >= SHARED_BUFFER_SIZE) {
        message = "Unknown error";
    }

    strcpy(data.dataBuffer, "EngineError");
    strcpy(data.dataBuffer + 11 + 1, message);
    data.dataSize = 11 + 1 + strlen(message);

    JS::RootedObject stack(cx);
    if (!JS::CaptureCurrentStack(cx, &stack) || !stack) {
        return;
    }

    JS::RootedValue stackVal(cx, JS::ObjectValue(*stack));
    uint32_t stackSize = SHARED_BUFFER_SIZE - data.dataSize - 1;
    if (!stringToFixedBuffer(stackVal, data.dataBuffer + data.dataSize + 1, stackSize)) {
        return;
    }

    data.dataSize += 1 + stackSize;

}

static void throwEngineError(const char* message = nullptr)
{
    throwEngineErrorInner(message);
    JS_ClearPendingException(cx);
}

struct GetPropertyResult {
    enum T : uint32_t {
        NotFound = 0,
        Ok = 1,
        Error = 2,
    };
    GetPropertyResult() = delete;
};

GetPropertyResult::T getProperty(JS::HandleObject obj, const char *name, JS::MutableHandleValue vp)
{
    bool found;

    if (!JS_HasProperty(cx, obj, name, &found)) {
        throwEngineError("Cannot get property from object.");
        return GetPropertyResult::Error;
    }

    if (found) {
        if (!JS_GetProperty(cx, obj, name, vp)) {
            throwEngineError("Cannot get property from object.");
            return GetPropertyResult::Error;
        }
        return GetPropertyResult::Ok;
    } else {
        return GetPropertyResult::NotFound;
    }
}

void throwPendingErrorInner()
{
    JS::RootedValue errorValue(cx);

    if (!JS_GetPendingException(cx, &errorValue)) {
        throwEngineError("Cannot get pending exception.");
        return;
    }

    data.dataType = ResultType::GuestError;

    if (errorValue.isObject()) {
        JS::RootedValue value(cx);
        JS::RootedObject errorObj(cx, &errorValue.toObject());
        char* ptr = data.auxBuffer;
        uint32_t size = 0;

        // Get error name
        auto r = getProperty(errorObj, "name", &value);
        if (r == GetPropertyResult::NotFound) {
            strcpy(ptr, "Error");
            size = 5;
        } else if (r == GetPropertyResult::Ok) {
            size = SHARED_BUFFER_SIZE - 1 - 14;
            if (!stringToFixedBuffer(value, ptr, size)) {
                throwEngineError("Error name too long.");
                return;
            }
        } else {
            return false;
        }

        // Add null separator
        ptr[size] = 0;
        size++;

        // Get error name
        r = getProperty(errorObj, "message", &value);
        if (r == GetPropertyResult::NotFound) {
            strcpy(ptr + size, "Unknown error");
            size += 13;
        } else if (r == GetPropertyResult::Ok) {
            uint32_t len = SHARED_BUFFER_SIZE - 1 - size;
            if (!stringToFixedBuffer(value, ptr + size, len)) {
                throwEngineError("Error name too long.");
                return;
            }
            size += len;
        } else {
            return false;
        }

        // Get error stack
        auto stack = ExceptionStackOrNull(errorObj);
        if (stack) {
            JS::RootedObject stackObj(cx, stack);
            JS::RootedValue stackVal(cx, JS::ObjectValue(*stackObj));
            if (!data.errorStack.set(stackVal)) return false;
        } else {
            data.errorStack.clear();
        }
    } else {
        data.resultValue.setConst("UnknownError");
        data.errorStack.clear();
        if (!data.errorMessage.set(errorValue)) {
            return throwEngineError("Cannot set return value.");
        }
    }
}


void throwPendingError() {
    throwPendingErrorInner();
    JS_ClearPendingException(cx);
}


WASM_EXPORT(setArg)
bool setArg(char* buffer, uint32_t size)
{
    auto argStr = moveToJSString(buffer, size);
    if (!argStr) {
        return throwPendingError();
    }

    bool found;
    if (!JS_HasProperty(cx, dx->sandboxObject, "_setArg", &found)) {
        return throwPendingError();
    }

    if (found) {
        JS::RootedValueArray<1> deserializeArgs(cx);
        JS::RootedValue deserializeRet(cx);
        deserializeArgs[0].setString(argStr);
        if (!JS_CallFunctionName(cx, dx->sandboxObject, "_setArg", deserializeArgs, &deserializeRet)) {
            return throwPendingError();
        }
    } else {
        JS::RootedValue arg(cx);
        arg.setString(argStr);
        if (!JS_SetProperty(cx, dx->sandboxObject, "_arg", arg)) {
            return throwPendingError();
        }
    }

    return true;
}


void returnResult(JS::HandleValue value) {

    bool found;
    if (!JS_HasProperty(cx, dx->sandboxObject, "_onDataToHost", &found)) {
        throwPendingError();
        return;
    } else if (found) {
        JS::RootedValueArray<1> args(cx);
        JS::RootedValue rval(cx);
        args[0].set(value);
        if (!JS_CallFunctionName(cx, dx->sandboxObject, "_onDataToHost", args, &rval)) {
            throwPendingError();
            return;
        }
        if (!data.result.set(rval)) {
            throwEngineError("Cannot set result.");
            return;
        }
    } else {
        if (!data.result.set(value)) {
            throwEngineError("Cannot set result.");
            return;
        }
    }
    data.errorMessage.clear();
    data.errorStack.clear();
    data.resultType = ResultType::Ok;
}

void returnVoid(JS::HandleValue value) {
    data.result.clear();
    data.errorMessage.clear();
    data.errorStack.clear();
    data.resultType = ResultType::Ok;
}

static const uint64_t CODE_CONTAINER_MAGIC = 0x415E38815E73FE08;

struct CodeContainer {
    uint64_t magic;
    ExecuteFlags::T flags;
    JS::PersistentRooted<JSScript*> script;
    CodeContainer(ExecuteFlags::T flags): magic(CODE_CONTAINER_MAGIC), flags(flags), script(cx) {
    }
    ~CodeContainer() {
        magic = 0;
    }
};

static uintptr_t minCodePtr = (uintptr_t)(-1);
static uintptr_t maxCodePtr = 0;

WASM_EXPORT(compile)
void* compile(const char* fileName, ExecuteFlags::T flags)
{
    // Prepare source code
    JSAutoRealm ar(cx, dx->globalObject);
    JS::SourceText<mozilla::Utf8Unit> source;
    if (!source.init(cx, sourceCode, sourceCodeSize, JS::SourceOwnership::Borrowed)) {
        throwEngineError("Cannot initialize source code.");
        return nullptr;
    }

    // Prepare options
    JS::CompileOptions options(cx);
    options
        .setFileAndLine(fileName, 1)
        .setNoScriptRval(!(flags & ExecuteFlags::ReturnValue))
        .setIsRunOnce(!!(flags & ExecuteFlags::Once));
    if (flags & ExecuteFlags::Module) {
        options.setModule();
    }

    CodeContainer* result = new CodeContainer(flags);

    // Compile
    bool ok = JS::Compile(cx, options, source, &result.script);
    data.clear();

    if (!ok) {
        delete result;
        throwPendingError();
        return nullptr;
    }

    if (maxCodePtr < (uintptr_t)result) maxCodePtr = (uintptr_t)result;
    if (minCodePtr > (uintptr_t)result) minCodePtr = (uintptr_t)result;

    return result;
}

WASM_EXPORT(dispose)
void dispose(void* code)
{
    CodeContainer* container = (CodeContainer*)code;
    if ((uintptr_t)code < minCodePtr || (uintptr_t)code > maxCodePtr || container->magic != CODE_CONTAINER_MAGIC) {
        return;
    }
    delete container;
}

static inline bool splitErrorFields(
    JS::MutableHandleValue name,
    JS::MutableHandleValue message,
    JS::MutableHandleValue stack
) {

    if (data.dataBuffer && data.dataSize > 0) {
        const char *str = data.dataBuffer;
        uint32_t len = strnlen_s(str, data.dataSize);
        name.setString(JS_NewStringCopyUTF8N(cx, JS::UTF8Chars(str, len)));
        uint32_t index = len + 1;
        if (index < data.dataSize) {
            str = data.dataBuffer + index;
            len = strnlen_s(str, data.dataSize - index);
            message.setString(JS_NewStringCopyUTF8N(cx, JS::UTF8Chars(str, len)));
            index += len + 1;
            if (index < data.dataSize) {
                stack.setString(JS_NewStringCopyUTF8N(cx, JS::UTF8Chars(data.dataBuffer + index, data.dataSize - index)));
            } else {
                stack.setUndefined();
            }
        } else {
            message.setString(JS_NewStringCopyZ(cx, "Unknown error"));
            stack.setUndefined();
        }
    } else {
        if (data.dataType == ResultType::GuestError) {
            name.setString(JS_NewStringCopyZ(cx, "GuestError"));
        } else if (data.dataType == ResultType::HostError) {
            name.setString(JS_NewStringCopyZ(cx, "HostError"));
        } else {
            name.setString(JS_NewStringCopyZ(cx, "EngineError"));
        }
        message.setString(JS_NewStringCopyZ(cx, "Unknown error"));
        stack.setUndefined();
    }

    data.clear();

    if (!name || !message || !stack) {
        throwEngineError("Cannot create error object from static data.");
        return false;
    }
    return true;
}

static bool staticDataToValue(JS::MutableHandleValue value, ResultType:T &type)
{
    type = data.dataType;

    if (data.dataType == ResultType::Value) {

        // NULL converts to undefined
        if (data.dataBuffer == nullptr) {
            value.setUndefined();
            return true;
        }

        // Convert to string and clear old data
        JSString* dataStr = JS_NewStringCopyUTF8N(cx, JS::UTF8Chars(data.dataBuffer, data.dataSize));
        data.clear();
        if (!dataStr) {
            throwEngineError("Cannot create string from static data.");
            return false;
        }

        // Check filter function
        bool filterFound;
        if (!JS_HasProperty(cx, dx->sandboxObject, "_onDataFromHost", &filterFound)) {
            throwPendingError();
            return false;
        }

        if (filterFound) {
            // Pass argument to the filter function and return it
            JS::RootedValueArray<1> filterArgs(cx);
            filterArgs[0].setString(dataStr);
            if (!JS_CallFunctionName(cx, dx->sandboxObject, "_onDataFromHost", filterArgs, &value)) {
                throwPendingError();
                return false;
            }
            return true;
        } else {
            // Return string directly
            value.setString(dataStr);
            return true;
        }

    } else {

        JS::RootedValue name;
        JS::RootedValue message;
        JS::RootedValue stack;

        // Split error fields from static data
        if (!splitErrorFields(&name, &message, &stack)) {
            return false;
        }

        // Get appropriate error constructor
        JS:RootedValue constructor(cx);
        GetPropertyResult::T res;
        if (data.dataType == ResultType::GuestError) {
            res = getProperty(dx->sandboxObject, "GuestError", &constructor);
        } else if (data.dataType == ResultType::HostError) {
            res = getProperty(dx->sandboxObject, "HostError", &constructor);
        } else {
            res = getProperty(dx->sandboxObject, "EngineError", &constructor);
        }
        
        // Fallback to default error constructor if not found
        if (res == GetPropertyResult::NotFound) {
            res = getProperty(dx->globalObject, "Error", &constructor);
        }

        // Check if constructor is found
        if (res != GetPropertyResult::Ok) {
            if (res == GetPropertyResult::NotFound) {
                throwEngineError("Cannot get Error constructor.");
            }
            return false;
        }

        // Create error object
        JS::AutoValueArray<1> args(cx);
        args[0].setString(message);
        value.setObject(JS_New(cx, constructor, args));
        if (!value) {
            throwPendingError();
            return false;
        }

        // Set name
        if (!JS_SetProperty(cx, value, "name", name)) {
            throwPendingError();
            return false;
        }

        // Set stack
        if (!stack.isUndefined()) {
            if (!JS_SetProperty(cx, value, "stack", stack)) {
                throwPendingError();
                return false;
            }
        }
    }

    auto argStr = moveToJSString(buffer, size);
    if (!argStr) {
        return throwPendingError();
    }

    bool found;
    if (!JS_HasProperty(cx, dx->sandboxObject, "_setArg", &found)) {
        return throwPendingError();
    }

    if (found) {
        JS::RootedValueArray<1> deserializeArgs(cx);
        JS::RootedValue deserializeRet(cx);
        deserializeArgs[0].setString(argStr);
        if (!JS_CallFunctionName(cx, dx->sandboxObject, "_setArg", deserializeArgs, &deserializeRet)) {
            return throwPendingError();
        }
    } else {
        JS::RootedValue arg(cx);
        arg.setString(argStr);
        if (!JS_SetProperty(cx, dx->sandboxObject, "_arg", arg)) {
            return throwPendingError();
        }
    }

    return true;
}


WASM_EXPORT(execute)
void execute(void* code)
{
    // Validate code container
    CodeContainer* container = (CodeContainer*)code;
    if ((uintptr_t)code < minCodePtr || (uintptr_t)code > maxCodePtr || container->magic != CODE_CONTAINER_MAGIC) {
        throwEngineError("Invalid compiled code.");
        return;
    }

    // Make sure that the code is not executed more than once is it is marked as such
    if (container->flags & ExecuteFlags::Once) {
        container->magic = 0;
    }

    // Get argument from static data
    JS::RootedValue arg(cx);
    ResultType:T argType;
    if (!staticDataToValue(&arg, argType)) {
        return;
    }

    // Check if the argument is not an exception
    if (argType != ResultType::Value) {
        throwEngineError("Thrown exception is not allowed as argument.");
        return;
    }

    // Put argument to the sandbox object
    if (!JS_SetProperty(cx, dx->sandboxObject, "arg", arg)) {
        throwPendingError();
        return;
    }

    // Execute and return result
    if (container->flags & ExecuteFlags::ReturnValue) {
        JS::RootedValue rval(cx);
        if (!JS_ExecuteScript(cx, script, &rval)) {
            throwPendingError();
            return;
        }
        returnResult(rval);
    } else {
        if (!JS_ExecuteScript(cx, script)) {
            throwPendingError();
            return;
        }
        returnVoid();
    }
}


WASM_EXPORT(call)
void call(uint32_t groupId, uint32_t functionId)
{
    JSAutoRealm ar(cx, dx->globalObject);
    JS::RootedValueArray<2> args(cx);
    args[0].setNumber(groupId);
    args[1].setNumber(functionId);
    JS::RootedValue rval(cx);
    if (!JS_CallFunctionName(cx, dx->sandboxObject, "_call", args, &rval)) {
        return throwPendingError();
    }
    data.result.set(rval);
    return true;
}


#pragma endregion


#pragma region ------------------ INITIALIZATION AND SANDBOX MANAGEMENT ------------------


WASM_EXPORT(malloc)
void* contextMalloc(uint32_t size)
{
    return JS_malloc(cx, size);
}


WASM_EXPORT(realloc)
void* contextRealloc(void* ptr, uint32_t oldSize, uint32_t newSize)
{
    if ((uint8_t*)ptr >= sharedBuffer && (uint8_t*)ptr < sharedBuffer + SHARED_BUFFER_SIZE) {
        void* res = JS_malloc(cx, newSize);
        memcpy(res, ptr, std::min(oldSize, newSize));
        return res;
    }
    return JS_realloc(cx, ptr, oldSize, newSize);
}


WASM_EXPORT(free)
void contextFree(void* ptr)
{
    if ((uint8_t*)ptr >= sharedBuffer && (uint8_t*)ptr < sharedBuffer + SHARED_BUFFER_SIZE || ptr == nullptr) {
        return;
    }
    JS_free(cx, ptr);
}


#define HOW_AGGRESSIVE 128 /* 0 - 256 */

void checkAggressiveGC(uint32_t heapBytes)
{
    if (
        heapBytes > currentThreshold &&
        cx &&
        !JS::RuntimeHeapIsBusy() &&
        JS::CheckIfGCAllowedInCurrentState(JS_GetRuntime(cx))
    ) {
        /*log("BEFORE: bytes %d - %d, num %d, major %d, minor %d, slice %d\n",
            heapBytes,
            JS_GetGCParameter(cx, JSGC_BYTES),
            JS_GetGCParameter(cx, JSGC_NUMBER),
            JS_GetGCParameter(cx, JSGC_MAJOR_GC_NUMBER),
            JS_GetGCParameter(cx, JSGC_MINOR_GC_NUMBER),
            JS_GetGCParameter(cx, JSGC_SLICE_NUMBER));*/
        auto before = JS_GetGCParameter(cx, JSGC_NUMBER);
        NonIncrementalGC(cx, JS::GCOptions::Normal, JS::GCReason::TOO_MUCH_MALLOC);
        auto after = JS_GetGCParameter(cx, JSGC_NUMBER);
        if (after != before) {
            uint32_t heapSize = realHeapBytes(cx);
            auto old = currentThreshold;
            currentThreshold = std::max(
                aggressiveGCThreshold,
                (uint32_t)(((uint64_t)(256 + HOW_AGGRESSIVE) * (uint64_t)heapSize
                + (uint64_t)(256 - HOW_AGGRESSIVE) * (uint64_t)hardGCThreshold) / (uint64_t)512));
            currentThreshold = std::max(currentThreshold, heapSize + MIN_THRESHOLD_INCREMENT);
            logInfo("heap %d KB -> %d KB, threshold %d KB -> %d KB", heapBytes / 1024, heapSize / 1024, old / 1024, currentThreshold / 1024);
        }
        /*log("AFTER: bytes %d - %d, num %d, major %d, minor %d, slice %d\n",
            heapBytes,
            JS_GetGCParameter(cx, JSGC_BYTES),
            JS_GetGCParameter(cx, JSGC_NUMBER),
            JS_GetGCParameter(cx, JSGC_MAJOR_GC_NUMBER),
            JS_GetGCParameter(cx, JSGC_MINOR_GC_NUMBER),
            JS_GetGCParameter(cx, JSGC_SLICE_NUMBER));*/
    }
}


WASM_EXPORT(init)
bool init(uint32_t aggressiveGCThreshold, uint32_t hardGCThreshold, uint32_t memoryLimit)
{
    ::aggressiveGCThreshold = aggressiveGCThreshold;
    ::hardGCThreshold = hardGCThreshold;
    ::memoryLimit = memoryLimit;
    currentThreshold = aggressiveGCThreshold;

    cx = JS_NewContext(std::max(aggressiveGCThreshold, hardGCThreshold / 4 * 3));
    if (!cx) {
        return false;
    }

    JS_malloc(cx, 10000);

    if (!JS::InitSelfHostedCode(cx)) {
        return false;
    }

    JS_SetGCParameter(cx, JSGC_INCREMENTAL_GC_ENABLED, 1);
    JS_SetGCParameter(cx, JSGC_BALANCED_HEAP_LIMITS_ENABLED, 0);
    JS_SetGCParameter(cx, JSGC_PER_ZONE_GC_ENABLED, 0);

    JS::RealmOptions options;
    JS::RootedObject globalObject(cx, JS_NewGlobalObject(cx, &SandboxGlobalClass, nullptr, JS::FireOnNewGlobalHook, options));

    if (!globalObject) {
        return false;
    }

    JSAutoRealm ar(cx, globalObject);

    dx = new DynamicContext(cx);
    dx->globalObject.set(globalObject);

    if (!defineSandboxObject()) {
        return false;
    }

    return true;
}


WASM_EXPORT(getSharedBufferPointer)
uint8_t* getSharedBufferPointer()
{
    return sharedBuffer;
}


WASM_EXPORT(getSharedBufferSize)
uint32_t getSharedBufferSize()
{
    return SHARED_BUFFER_SIZE;
}


int main(int argc, const char* argv[]) {
    initialMemorySize = getMemorySize();
    initialStackPointer = getStackPointer();
    if (!JS_Init()) {
        return 1;
    }
    return hostEntry();
}


#pragma endregion


void HostExportedString::setConst(const char* text) {
    clear();
    size = strlen(text);
    buffer = (char*)text;
    onHeap = 0;
}

void HostExportedString::set(char* buffer, int size) {
    clear();
    if (size == -1) {
        size = strlen(buffer);
    }
    this->buffer = buffer;
    this->size = size;
    this->onHeap = 1;
}

bool HostExportedString::set(JS::HandleValue value)
{
    uint32_t size;
    auto buffer = stringToBuffer(value, size);
    if (!buffer) {
        clear();
        return throwEngineError("Cannot allocate buffer for error string.");
    }
    set(buffer, size);
    return true;
}

bool HostExportedString::set(JS::HandleString value)
{
    uint32_t size;
    auto buffer = stringToBuffer(value, size);
    if (!buffer) {
        clear();
        return throwEngineError("Cannot allocate buffer for string.");
    }
    set(buffer, size);
    return true;
}

void HostExportedString::clear() {
    if (onHeap) {
        contextFree(buffer);
    }
    buffer = nullptr;
}

WASM_EXPORT(getStaticData)
StaticData* getStaticData()
{
    return &data;
}
