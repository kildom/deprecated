#pragma region ------------------ GLOBAL VARIABLES ------------------


struct DynamicContext {

    JS::PersistentRootedObject globalObject;
    JS::PersistentRootedObject sandboxObject;
    JS::PersistentRootedValue sandboxValue;
    JS::PersistentRootedObject memObject;
    JS::PersistentRootedValue memValue;

    DynamicContext(JSContext* cx):
        globalObject(cx),
        sandboxObject(cx),
        sandboxValue(cx),
        memObject(cx),
        memValue(cx)
    {
    }

};

static const uint32_t SHARED_BUFFER_SIZE = 32 * 1024;
static const uint32_t MIN_THRESHOLD_INCREMENT = 8 * 1024;

static JSContext* cx;
static char sharedBuffer[SHARED_BUFFER_SIZE];
static DynamicContext* dx;

static JSClass SandboxGlobalClass = { "SandboxGlobal", JSCLASS_GLOBAL_FLAGS, &JS::DefaultGlobalClassOps };

static StaticData data = {
    .auxBuffer = sharedBuffer,
    .auxSize = SHARED_BUFFER_SIZE,
};


#pragma endregion


#pragma region ------------------ DEBUG LOGGING ------------------


static void _log(LogLevel::T level, const char* format, ...)
{
    if (level > data.logLevel) {
        return;
    }
    int size = 1024;
    if (0) { // TODO: Fix this
        static char tmp[1];
        std::va_list args;
        size = vsnprintf(tmp, 1, format, args) + 1024;
        va_end(args);
    }
    {
        char *ptr = (char*)malloc(size + 1);
        if (!ptr) {
            hostLog(level, "malloc failed!", 14);
            return;
        }
        std::va_list args;
        va_start(args, format);
        size = vsnprintf(ptr, size + 1, format, args);
        va_end(args);
        hostLog(level, ptr, size);
        free(ptr);
    }
}

#define logError(format, ...) _log(LogLevel::Error, format, ##__VA_ARGS__)
#define logWarning(format, ...) _log(LogLevel::Warning, format, ##__VA_ARGS__)
#define logInfo(format, ...) _log(LogLevel::Info, format, ##__VA_ARGS__)

